{
  "expo": {
    "name": "Sirens",
    "slug": "Sirens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./logo/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sirens.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo/logo.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.sirens.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ]
  }
}
