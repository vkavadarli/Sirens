{
  "expo": {
    "name": "Sirens",
    "slug": "sirens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sirens.app"
    },
    "android": {
      "icon": "./logo/logo.png",
      "package": "com.sirens.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./logo/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d60cdad-d901-430d-8b62-f183dc1eed09"
      }
    },
    "owner": "vkavadarlis-team"
  }
}
